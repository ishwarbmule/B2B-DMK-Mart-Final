# ============================================================
# B2B DMK Mart — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- 1. App database (Prisma) — REQUIRED ---
# Local development (SQLite):
APP_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# (Vercel: set APP_DATABASE_URL to your Neon pooled connection string)
# Production with Neon Postgres (if you switch the app DB):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- 2. Public site URL — RECOMMENDED ---
# Used to generate sitemap.xml and robots.txt absolute URLs.
# Falls back to https://dmkmartb2b.space-z.ai if unset.
NEXT_PUBLIC_SITE_URL="https://dmkmartb2b.space-z.ai"

# --- 3. ERP (Neon) connection — REQUIRED for ERP sync ---
# Enables the "Pull ERP" button in Super Admin + live catalog sync.
# Same Neon connection string used by the ERP platform.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- 4. ERP webhook API key — REQUIRED for auto-push ---
# Your ERP's IntegrationPortal ("DMK B2B" integration) pushes products to
# /api/inventory/webhook. The key here MUST match the key configured on the
# ERP side, otherwise every auto-push is rejected with 401.
# Generate a strong random string, e.g.:  openssl rand -hex 32
ERP_WEBHOOK_API_KEY=""

# --- 5. Admin panel login — RECOMMENDED to override in production ---
# Defaults to the built-in credentials if unset.
ADMIN_LOGIN_ID="B2B DMK Mart"
ADMIN_PASSWORD=""

# --- 6. Auth signing secrets — REQUIRED in production ---
# Used to sign admin/customer session tokens. Any random 32+ char string.
# Generate:  openssl rand -hex 32
ADMIN_AUTH_SECRET=""
CUSTOMER_AUTH_SECRET=""

# --- 7. Cloudinary image hosting — REQUIRED for ad/logo uploads ---
CLOUDINARY_CLOUD_NAME="dmkmart"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- 8. SMS gateway (optional) — configure from Admin → Settings instead ---
# The admin Settings panel stores sms_provider / sms_api_key / sms_sender_id in the
# database (no redeploy needed). These env vars are NOT required; the Setting table wins.
# Providers supported: OFF (demo) | TWILIO | MSG91 | FAST2SMS | TWOFACTOR
