# ============================================================
# B2B DMK Mart — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- 1. App database (Prisma) — REQUIRED — MySQL, NO Neon ---
# The B2B store now runs on your own MySQL server (e.g. the same machine as
# the ERP, in its OWN database). Create a dedicated database for the website,
# e.g. `dmk_b2b`, then a dedicated user for it. Never point the website at the
# ERP database itself.
# Local (MySQL):  APP_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dmk_b2b"
# Vercel (remote): APP_DATABASE_URL="mysql://USER:PASSWORD@YOUR-HOST:3306/dmk_b2b"
# First-time table creation:  npx prisma db push   (with this URL set)
APP_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dmk_b2b"

# --- 2. Public site URL — RECOMMENDED ---
# Used to generate sitemap.xml and robots.txt absolute URLs.
# Falls back to https://dmkmartb2b.space-z.ai if unset.
NEXT_PUBLIC_SITE_URL="https://dmkmartb2b.space-z.ai"

# --- 3. ERP MySQL connection (sync target) — set here OR in Admin → Data Sync ---
# The ERP's own MySQL database. The website connects STRICTLY READ-ONLY:
# every query is SELECT/SHOW/DESCRIBE and writes stay locked behind the
# Admin → Data Sync toggle. Env vars win; the admin-panel form is the fallback.
ERP_MYSQL_HOST=""
ERP_MYSQL_PORT="3306"
ERP_MYSQL_USER=""
ERP_MYSQL_PASSWORD=""
ERP_MYSQL_DATABASE=""

# --- 4. ERP webhook API key — REQUIRED for ERP auto-push to the website ---
# Your ERP can push products to /api/inventory/webhook (x-api-key header).
# The key here MUST match the key configured on the ERP side, otherwise every
# auto-push is rejected with 401.  Generate:  openssl rand -hex 32
ERP_WEBHOOK_API_KEY=""

# --- 5. Admin panel login — RECOMMENDED to override in production ---
# Defaults to the built-in credentials if unset.
ADMIN_LOGIN_ID="B2B DMK Mart"
ADMIN_PASSWORD=""

# --- 6. Auth signing secrets — REQUIRED in production ---
# Used to sign admin/customer session tokens. Any random 32+ char string.
# Generate:  openssl rand -hex 32
ADMIN_AUTH_SECRET=""
CUSTOMER_AUTH_SECRET=""

# --- 7. Cloudinary image hosting — REQUIRED for ad/logo uploads (unchanged) ---
CLOUDINARY_CLOUD_NAME="dmkmart"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- 8. SMS gateway (optional) — configure from Admin → Settings instead ---
# The admin Settings panel stores sms_provider / sms_api_key / sms_sender_id in the
# database (no redeploy needed). These env vars are NOT required; the Setting table wins.
# Providers supported: OFF (demo) | TWILIO | MSG91 | FAST2SMS | TWOFACTOR
