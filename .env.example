# ============================================================
# B2B DMK Mart — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- 1. App database (Prisma) — REQUIRED — MySQL, NO Neon ---
# The B2B store runs on its own MySQL database (e.g. u671486929_dmkmartweb on
# the same Hostinger server as the ERP). NEVER point the website at the ERP DB.
# Local (MySQL):  APP_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dmk_b2b"
# Vercel (remote): APP_DATABASE_URL="mysql://USER:PASSWORD@srv844.hstgr.io:3306/u671486929_dmkmartweb"
# Local sandbox dev uses the SQLite twin: prisma/schema.sqlite.prisma + db/custom.db
APP_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dmk_b2b"

# --- 2. Public site URL — RECOMMENDED ---
# Used to generate sitemap.xml and robots.txt absolute URLs.
NEXT_PUBLIC_SITE_URL="https://b2b-dmk-mart.vercel.app"

# --- 3. Admin panel login — RECOMMENDED to override in production ---
# Defaults to the built-in credentials if unset.
ADMIN_LOGIN_ID="B2B DMK Mart"
ADMIN_PASSWORD=""

# --- 4. Auth signing secrets — REQUIRED in production ---
# Used to sign admin/customer session tokens. Any random 32+ char string.
# Generate:  openssl rand -hex 32
ADMIN_AUTH_SECRET=""
CUSTOMER_AUTH_SECRET=""

# --- 5. Cron secret — REQUIRED for the daily delta pull on Vercel ---
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/erp-delta.
# Generate:  openssl rand -hex 32
CRON_SECRET=""

# --- 6. Cloudinary image hosting — REQUIRED for ad/logo/product-image uploads ---
CLOUDINARY_CLOUD_NAME="dmkmart"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- 7. Universal Inventory API (dmkmarterp.in) — set here OR in Admin → Inventory Sync ---
# The ONLY product integration: REST pulls + signed webhook pushes.
#   Health  : GET  {url}/api/universal/v1/health   (header X-API-Key)
#   Pull    : GET  {url}/api/universal/v1/products?limit=200&offset=0[&since=ISO]
#   Push in : POST /api/dmk-inventory/sync         (header X-DMK-Signature: sha256=HMAC(body, push secret))
# Env vars win; the admin Inventory Sync form (stored in the DB) is the fallback.
ERP_UNIVERSAL_URL="https://dmkmarterp.in"
ERP_UNIVERSAL_API_KEY=""
ERP_UNIVERSAL_PUSH_SECRET=""

# --- 8. SMS gateway (optional) — configure from Admin → Settings instead ---
# The admin Settings panel stores sms_provider / sms_api_key / sms_sender_id in the
# database (no redeploy needed). These env vars are NOT required; the Setting table wins.
# Providers supported: OFF (demo) | TWILIO | MSG91 | FAST2SMS | TWOFACTOR
