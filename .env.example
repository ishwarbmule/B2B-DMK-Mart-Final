# ============================================================
# B2B DMK Mart — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- 1. App database (Prisma) — REQUIRED — Neon Postgres ---
# The app database (accounts, orders, settings, ERP catalog cache/overlay) lives
# on Neon (Lakebase Postgres). Pooled URL for the app, DIRECT URL for migrations
# (`neon deploy` writes DATABASE_URL / DATABASE_URL_UNPOOLED — map them here).
# Local sandbox dev uses the SQLite twin: prisma/schema.sqlite.prisma + db/custom.db
APP_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
APP_DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- 2. ERP MySQL — direct read-only connection — REQUIRED ---
# The owner shares the ERP database (remote MySQL feature). The website NEVER
# writes to it: every query goes through the read-only guard (SELECT/SHOW/
# DESCRIBE/EXPLAIN only, no stacked statements). Orders are entered in the ERP
# software by the team; ERP stock reduces there; the next sync reads it.
# Set here OR in Admin → ERP Data (MySQL) (stored in the DB, masked).
ERP_MYSQL_HOST="srv844.hstgr.io"
ERP_MYSQL_PORT="3306"
ERP_MYSQL_USER=""
ERP_MYSQL_PASSWORD=""
ERP_MYSQL_DATABASE=""

# --- 3. Public site URL — RECOMMENDED ---
# Used to generate sitemap.xml and robots.txt absolute URLs.
NEXT_PUBLIC_SITE_URL="https://b2b-dmk-mart.vercel.app"

# --- 4. Admin panel login — RECOMMENDED to override in production ---
# Defaults to the built-in credentials if unset.
ADMIN_LOGIN_ID="B2B DMK Mart"
ADMIN_PASSWORD=""

# --- 5. Auth signing secrets — REQUIRED in production ---
# Used to sign admin/customer session tokens. Any random 32+ char string.
# Generate:  openssl rand -hex 32
ADMIN_AUTH_SECRET=""
CUSTOMER_AUTH_SECRET=""

# --- 6. Cron secret — REQUIRED for the 15-min ERP sync tick on Vercel ---
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/erp-sync.
# Generate:  openssl rand -hex 32
CRON_SECRET=""

# --- 7. Cloudinary image hosting — REQUIRED for ad/logo/product-image uploads ---
CLOUDINARY_CLOUD_NAME="dmkmart"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- 8. SMS gateway (optional) — configure from Admin → Settings instead ---
# The admin Settings panel stores sms_provider / sms_api_key / sms_sender_id in the
# database (no redeploy needed). These env vars are NOT required; the Setting table wins.
# Providers supported: OFF (demo) | TWILIO | MSG91 | FAST2SMS | TWOFACTOR
