generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL — the B2B store now lives on the owner's own MySQL server (no Neon).
  // Local sandbox preview uses the SQLite twin at prisma/schema.sqlite.prisma.
  // Dedicated env name: the sandbox platform injects its own DATABASE_URL (sqlite),
  // which would override .env. APP_DATABASE_URL is app-owned everywhere (local + Vercel).
  provider = "mysql"
  url      = env("APP_DATABASE_URL")
}

// ───────────────────────── BRANDS (DMK Mart sells many brands) ─────────────────────────

model Brand {
  id               String    @id @default(cuid())
  name             String    @unique
  slug             String    @unique
  logo             String    @default("") // Cloudinary brand-logos URL
  banner           String    @default("")
  description      String    @default("") @db.Text
  tagline          String    @default("") @db.Text
  color            String    @default("#111111")
  erpNames         String    @default("[]") @db.Text // JSON: aliases of ERP company/brand strings
  storefrontLayout Int       @default(1) // 1..10 template id
  storefrontConfig String    @default("{}") // JSON layout config (hero text, colors, sections)
  isFeatured       Boolean   @default(false)
  sortOrder        Int       @default(0)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
  ads              Ad[]
}

// ───────────────────────── CATEGORIES (3-level) ─────────────────────────

model TopCategory {
  id       String        @id @default(cuid())
  name     String        @unique
  emoji    String        @default("🧺")
  image    String        @default("")
  color    String        @default("#facc15")
  sortOrder Int          @default(0)
  mids     MidCategory[]
  products Product[]
}

model MidCategory {
  id       String        @id @default(cuid())
  name     String
  topId    String
  top      TopCategory   @relation(fields: [topId], references: [id], onDelete: Cascade)
  ends     EndCategory[]
  products Product[]

  @@unique([topId, name])
}

model EndCategory {
  id       String      @id @default(cuid())
  name     String
  midId    String
  mid      MidCategory @relation(fields: [midId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([midId, name])
}

// ───────────────────────── PRODUCTS ─────────────────────────

model Product {
  id                String      @id @default(cuid())
  sku               String      @unique // canonical SKU (ERP SKU for synced items)
  legacySku         String      @default("")
  erpId             String      @default("") // ERP MySQL row id
  slug              String      @unique
  name              String
  brandId           String
  brand             Brand       @relation(fields: [brandId], references: [id])
  topId             String
  top               TopCategory @relation(fields: [topId], references: [id])
  midId             String
  mid               MidCategory @relation(fields: [midId], references: [id])
  endId             String
  end               EndCategory @relation(fields: [endId], references: [id])

  // units
  unit              String      @default("Pcs")
  packQty           Int         @default(1) // pieces per pack
  piecesPerBox      Int         @default(0) // pieces per bulk box

  // pricing (purchaseCost NEVER leaves admin panel)
  purchaseCost      Float       @default(0)
  dealerPrice       Float // selling price shown (tier4 default)
  basePrice         Float       @default(0)
  mrp               Float
  tier1             Float       @default(0)
  tier2             Float       @default(0)
  tier3             Float       @default(0)
  tier4             Float       @default(0)
  tier5             Float       @default(0)
  packPrice         Float       @default(0)
  packDiscountPct   Float       @default(0)
  dealPrice         Float       @default(0) // hot deal / deal-of-day price

  // stock
  stock             Float       @default(0)
  damagedStock      Float       @default(0)
  reservedQty       Float       @default(0)
  lowStockThreshold Int         @default(10)

  // compliance / logistics
  barcode           String      @default("")
  hsn               String      @default("")
  gst               Float       @default(18)
  weightGrams       Float       @default(0)

  // media + content
  image             String      @default("")
  gallery           String      @default("[]")
  description       String      @default("") @db.Text

  // SEO
  seoTitle          String      @default("")
  seoDesc           String      @default("")
  keywords          String      @default("")

  // merchandising
  rating            Float       @default(4.5)
  reviewCount       Int         @default(0)
  isHot             Boolean     @default(false)
  isTop             Boolean     @default(false)
  isFeatured        Boolean     @default(false)
  isDeal            Boolean     @default(false)

  active            Boolean     @default(true)
  activeSource      String      @default("ERP") // ERP = pull controls it | ADMIN = admin manually set it (pull never overrides)
  syncSource        String      @default("LOCAL") // ERP | LOCAL | LEGACY
  lastSyncedAt      DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orderItems        OrderItem[]
  warehouseStocks   WarehouseStock[]

  @@index([name])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isDeal])
  @@index([active])
}

// ───────────────────────── CUSTOMERS (B2B: retailers, wholesalers, distributors) ─────────────────────────

model Customer {
  id           String   @id @default(cuid())
  name         String
  shopName     String   @default("")
  phone        String   @unique
  email        String   @default("")
  password     String   @default("")
  gstin        String   @default("")
  address      String   @default("") @db.Text
  city         String   @default("")
  pincode      String   @default("")
  customerType String   @default("RETAILER") // RETAILER | WHOLESALE | SEMI_WHOLESALE | DISTRIBUTOR
  tier         String   @default("tier4") // tier1..tier4 price tier
  creditLimit  Float    @default(0)
  creditBalance Float  @default(0) // money credited back (out-of-stock lines) — admin-visible only
  status       String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  approvedAt   DateTime?
  approvedBy   String   @default("")
  source       String   @default("WEB") // WEB | ERP
  erpId        String   @default("")
  orders       Int      @default(0)
  totalSpent   Float    @default(0)
  createdAt    DateTime @default(now())
}

// ───────────────────────── ORDERS (OTP + unit-aware items) ─────────────────────────

model Order {
  id             String      @id @default(cuid())
  invoiceNo      String      @default("")
  otp            String      @default("") // 4-digit delivery OTP
  otpSentAt      DateTime?
  items          OrderItem[]
  totalCases     Int         @default(0)
  totalUnits     Int         @default(0)
  itemTotal      Float
  gstAmount      Float       @default(0)
  deliveryFee    Float       @default(0)
  discount       Float       @default(0)
  couponCode     String      @default("")
  offerId        String      @default("")
  grandTotal     Float
  totalSavings   Float       @default(0)
  customerId     String      @default("")
  customerName   String
  customerType   String      @default("GUEST") // GUEST | RETAILER | WHOLESALE | DISTRIBUTOR
  priceTier      String      @default("tier4")
  phone          String
  email          String      @default("")
  addressLine    String @db.Text
  city           String
  pincode        String
  zone           String      @default("")
  slot           String      @default("Express 2-hour")
  paymentMethod  String      @default("UPI")
  paymentStatus  String      @default("PENDING")
  waOptIn        Boolean     @default(false) // customer consented to WhatsApp order updates at checkout
  // Task 15: fulfillment — DELIVERY (to buyer address, pack pricing) | PICKUP (from warehouse, per-piece slab pricing)
  fulfillment          String  @default("DELIVERY")
  pickupWarehouseId    String  @default("")
  pickupWarehouseName  String  @default("")
  confirmedAt    DateTime?   // set when admin confirms the order (stock checked here)
  confirmedBy    String      @default("")
  nextDeliveryAt String      @default("") // planned next delivery date for out-of-stock lines
  shippingStatus String      @default("PENDING")
  status         String      @default("PENDING")
  source         String      @default("WEB")
  storeId        String      @default("")
  salesPerson    String      @default("")
  deliveryMan    String      @default("")
  note           String      @default("")
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String
  name      String
  image     String  @default("")
  unitType  String  @default("SINGLE") // SINGLE | PACK | BULK
  packQty   Int     @default(1)
  qty       Float // number of that unit type
  pieces    Float // total pieces = qty * packQty
  unitPrice Float // price per unit type
  discount  Float   @default(0)
  gst       Float   @default(18)
  hsn       String  @default("")
  total     Float
  barcode   String  @default("")
  serialNo  Int     @default(0) // per-order serial (1..n) assigned at admin confirm
  lineStatus String @default("OK") // OK = ships now | NEXT_PLAN = out of stock, next delivery + credited
  plannedNote String @default("") // e.g. "Next delivery 05 Nov 2026 — amount credited"
}

// ───────────────────────── WAREHOUSES (multi-godown stock) ─────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @default("")
  address   String   @default("") @db.Text
  city      String   @default("")
  phone     String   @default("")
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stocks    WarehouseStock[]
  transfersFrom StockTransfer[] @relation("transfersFrom")
  transfersTo   StockTransfer[] @relation("transfersTo")
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty         Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

// ───────────────────────── STOCK TRANSFERS (warehouse → warehouse, single or bulk) ─────────────────────────

model StockTransfer {
  id              String    @id @default(cuid())
  code            String    @unique // TRF-0001
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("transfersFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("transfersTo", fields: [toWarehouseId], references: [id])
  status          String    @default("RECEIVED") // RECEIVED = executed atomically on create
  note            String    @default("")
  itemCount       Int       @default(0)
  totalQty        Int       @default(0)
  createdBy       String    @default("Super Admin")
  createdAt       DateTime  @default(now())
  items           StockTransferItem[]
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  sku        String        @default("")
  name       String        @default("")
  qty        Int
}

// ───────────────────────── OFFERS & COUPONS (Big Million Days engine) ─────────────────────────

model Offer {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  type          String   @default("MEGA_SALE") // FESTIVAL | SEASON | MEGA_SALE | CLEARANCE
  headline      String   @default("") @db.Text
  subText       String   @default("") @db.Text
  ctaText       String   @default("Shop Now")
  ctaUrl        String   @default("#deals")
  bannerImage   String   @default("")
  contentPosition String @default("TOP-LEFT") // where promo copy + CTA sit on the 16:9 banner: TOP-LEFT | TOP-RIGHT | CENTER | BOTTOM-LEFT | BOTTOM-RIGHT
  bgColor       String   @default("#111111")
  textColor     String   @default("#facc15")
  // Offer style v2 — per-element admin styling with SEPARATE laptop & mobile values ("" / 0 = theme auto)
  kickerColor      String @default("") // small "Limited Period Campaign" line; empty = textColor
  kickerSize       Int    @default(0)  // px laptop; 0 = auto
  kickerSizeM      Int    @default(0)  // px mobile; 0 = auto
  headlineColor    String @default("") // empty = textColor
  headlineSize     Int    @default(0)  // px laptop; 0 = auto
  headlineSizeM    Int    @default(0)  // px mobile; 0 = auto
  subColor         String @default("") // description line; empty = textColor
  subSize          Int    @default(0)
  subSizeM         Int    @default(0)
  buttonBg         String @default("") // empty = brand black
  buttonTextColor  String @default("") // empty = brand yellow
  buttonSize       Int    @default(0)
  buttonSizeM      Int    @default(0)
  padTop           Int    @default(50) // content block padding, laptop px
  padBottom        Int    @default(50)
  padLeft          Int    @default(50)
  padRight         Int    @default(50)
  padTopM          Int    @default(0) // px mobile; 0 = auto-derive (brand 14–24px)
  padBottomM       Int    @default(0)
  padLeftM         Int    @default(0)
  padRightM        Int    @default(0)
  marqueeBg        String @default("") // yellow scrolling bar; empty = brand yellow
  marqueeTextColor String @default("") // empty = black
  marqueeSize      Int    @default(0)
  marqueeSizeM     Int    @default(0)
  heroSlot      Boolean  @default(true) // auto-appear in homepage hero
  startAt       DateTime?
  endAt         DateTime?
  scopeType     String   @default("ALL") // ALL | BRAND | CATEGORY | PRODUCT
  scopeIds      String   @default("[]") @db.Text // JSON id list
  discountType  String   @default("PERCENT") // PERCENT | AMOUNT
  discountValue Float    @default(0)
  minOrder      Float    @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  headline    String    @default("") @db.Text // creative text shown on homepage card
  subText     String    @default("") @db.Text
  type        String    @default("PERCENT") // PERCENT | AMOUNT
  value       Float
  minOrder    Float     @default(0)
  maxDiscount Float     @default(0)
  bgColor     String    @default("#111111")
  textColor   String    @default("#facc15")
  scopeType   String    @default("ALL") // ALL | BRAND | CATEGORY | PRODUCT
  scopeIds    String    @default("[]") @db.Text
  usageLimit  Int       @default(0) // 0 = unlimited
  usedCount   Int       @default(0)
  showOnHome  Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ───────────────────────── WEBSITE MANAGEMENT (pages, SEO, sitemap) ─────────────────────────

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  type            String   @default("CUSTOM") // SYSTEM | CUSTOM | LEGAL
  blocks          String   @default("[]") @db.Text // JSON canvas blocks
  metaTitle       String   @default("")
  metaDescription String   @default("") @db.Text
  keywords        String   @default("")
  ogImage         String   @default("")
  inFooter        Boolean  @default(false)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SeoMeta {
  path            String  @id // e.g. "/", "/catalog", "/brands"
  title           String  @default("")
  description     String  @default("") @db.Text
  keywords        String  @default("")
  ogImage         String  @default("")
  noindex         Boolean @default(false)
  extraHead       String  @default("")
}

// ───────────────────────── ERP SYNC (owner's ERP MySQL <-> ecommerce) ─────────────────────────

model SyncEvent {
  id           String   @id @default(cuid())
  direction    String // PULL_ERP | PUSH_ERP | WEBHOOK_IN
  action       String // PRODUCTS | CUSTOMERS | ...
  status       String   @default("OK") // OK | ERROR | PARTIAL
  message      String   @default("")
  productsSeen Int      @default(0)
  created      Int      @default(0)
  updated      Int      @default(0)
  skipped      Int      @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())
}

model PriceChangeLog {
  id        String   @id @default(cuid())
  productId String
  sku       String   @default("")
  name      String   @default("")
  field     String // mrp | dealerPrice | tier1..5 | dealPrice
  oldVal    Float
  newVal    Float
  basis     String   @default("") // e.g. "purchaseCost + 18%"
  user      String   @default("Super Admin")
  createdAt DateTime @default(now())
}

// ───────────────────────── LEGACY / SUPPORT MODULES ─────────────────────────

model Store {
  id        String   @id @default(cuid())
  name      String
  manager   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  zone      String   @default("West")
  city      String   @default("")
  area      String   @default("")
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
}

model Zone {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model PriceSlab {
  id          String   @id @default(cuid())
  title       String
  minQty      Int      @default(0)
  discountPct Float    @default(0)
  note        String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Slider {
  id          String  @id @default(cuid())
  heading     String
  content     String  @default("") @db.Text
  buttonText  String  @default("Shop Now")
  buttonUrl   String  @default("#deals")
  image       String  @default("")
  mobileImage String  @default("") // 3:4 portrait artwork shown on phones (art direction)
  kicker      String  @default("") // small uppercase eyebrow line above the heading
  highlight   String  @default("") // headline words shown in yellow accent (two-tone, like old artwork)
  chips       String  @default("") // comma-separated USP chips, e.g. "Wide Product Range,Trusted Quality"
  tagline     String  @default("") // script-font tagline, top-right on wide screens
  mobilePosition String @default("") // 9-zone copy placement on phones, e.g. TOP-LEFT
  textColor   String  @default("DARK") // DARK (light walls) or LIGHT (dark walls) — no scrim is drawn
  headingScale String @default("M") // S / M / L headline size — content must fit the vacant space
  // Hero v5 — per-element styling controls (Admin → Website Management → Hero Section)
  kickerColor     String  @default("") // hex; empty = theme ink
  kickerSize      Int     @default(0)  // px desktop; 0 = auto
  headingColor    String  @default("") // hex; empty = theme ink
  headingSize     Int     @default(0)  // px desktop; 0 = auto (headingScale presets)
  headingColors   String  @default("[]") // JSON palette cycling across *star* words in the heading
  highlightColor  String  @default("") // hex for the `highlight` words; empty = amber
  contentColor    String  @default("")
  contentSize     Int     @default(0)  // px desktop; 0 = auto
  taglineColor    String  @default("")
  buttonBg        String  @default("") // hex; empty = brand black
  buttonTextColor String  @default("") // hex; empty = brand yellow
  padTop          Int     @default(50) // content+buttons block only — image always stays full-bleed
  padBottom       Int     @default(50)
  padLeft         Int     @default(50)
  padRight        Int     @default(50)
  position    String  @default("LEFT")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Ad {
  id        String  @id @default(cuid())
  title     String
  link      String  @default("#")
  image     String  @default("")
  brandId   String?
  brand     Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model SalesPerson {
  id            String   @id @default(cuid())
  name          String
  mobile        String   @unique
  historyAccess Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model DeliveryMan {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @default("")
  phone     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  role        String   @default("COMPANY_ADMIN")
  permissions String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String   @default("")
  detail    String   @default("")
  user      String   @default("Super Admin")
  createdAt DateTime @default(now())
}

model Purchase {
  id        String   @id @default(cuid())
  ref       String   @default("")
  company   String
  product   String
  qty       Int
  rate      Float
  amount    Float
  note      String   @default("")
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  product   String
  qty       Int
  reason    String
  amount    Float    @default(0)
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}

model Size {
  id   String @id @default(cuid())
  name String @unique
}

model Color {
  id   String @id @default(cuid())
  name String @unique
  hex  String @default("#000000")
}

// ───────────────────────── CUSTOMER LOGIN OTP (Amazon/Flipkart-style flows) ─────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  identifier String  // phone (10-digit) or email (lowercased)
  code      String   // 6-digit OTP
  purpose   String   @default("LOGIN") // LOGIN | RESET
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([identifier, purpose])
}
